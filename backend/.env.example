# ─── Application ────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lexsentry:lexsentry_secret@db:5432/lexsentry
SYNC_DATABASE_URL=postgresql://lexsentry:lexsentry_secret@db:5432/lexsentry

# ─── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── LLM (Google Gemini) ────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ─── Storage ────────────────────────────────────────────────
STORAGE_DIR=/app/storage

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Email Notifications (optional) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=lexsentry@yourfirm.com
NOTIFICATION_TO_EMAILS=lawyer@yourfirm.com
